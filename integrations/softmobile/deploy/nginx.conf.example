# Safe initial Nginx virtual host for chat.invjear.com.
# ACME webroot succeeds on HTTP while all non-ACME URLs remain unavailable.
# DO NOT serve the login page over HTTP. Enable the HTTPS template only after
# chat.invjear.com resolves to this server and the certificate has been issued.
server {
    listen 80;
    listen [::]:80;
    server_name chat.invjear.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store" always;
        return 503 "HTTPS setup pending\n";
    }
}
