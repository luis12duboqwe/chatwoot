# Local-only test install. This file must NOT be used with placeholder secrets.
# Copy into a private directory as .env, then generate independent random secrets.
FRONTEND_URL=http://127.0.0.1:3100
INSTALLATION_NAME=SoftMobile
DEFAULT_LOCALE=es
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=false
RAILS_ENV=production
RAILS_MAX_THREADS=5
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true
NODE_ENV=production
INSTALLATION_ENV=docker
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=GENERATE_RANDOM_48_HEX
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=GENERATE_RANDOM_48_HEX
SECRET_KEY_BASE=GENERATE_RANDOM_128_HEX
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=GENERATE_RANDOM_64_HEX
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=GENERATE_RANDOM_64_HEX
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=GENERATE_RANDOM_64_HEX
