[Unit]
Description=SoftMobile isolated patch review proposals
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/softmobile/groq.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/softmobile-waha-test/laboratorio-ia
Environment=SOFTMOBILE_UNTRUSTED_PROPOSALS_ENABLED=true
Environment=SOFTMOBILE_AI_MODEL=openai/gpt-oss-20b
ExecStart=/usr/bin/python3 /opt/softmobile-waha-test/laboratorio-ia/patch_proposer.py --run
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=105
