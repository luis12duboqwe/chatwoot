[Unit]
Description=SoftMobile stepwise Groq simulated customer and independent quality review
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/softmobile/groq.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/softmobile-waha-test/laboratorio-ia
Environment=SOFTMOBILE_INTERACTIVE_LAB_ENABLED=true
Environment=SOFTMOBILE_AI_MODEL=openai/gpt-oss-20b
ExecStart=/usr/bin/python3 /opt/softmobile-waha-test/laboratorio-ia/interactive_lab.py --run
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=240
